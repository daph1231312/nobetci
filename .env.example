# Copy this file to .env and fill it in. .env is gitignored — it holds a
# password and must never be committed.
#
# Gmail needs an APP PASSWORD, not your normal account password:
#   myaccount.google.com  ->  Security  ->  2-Step Verification  ->  App passwords
# Google shows a 16-character code once. Paste it below without spaces.

NOBETCI_SMTP_HOST=smtp.gmail.com
NOBETCI_SMTP_PORT=587
NOBETCI_SMTP_USER=you@gmail.com
NOBETCI_SMTP_PASS=your-16-char-app-password
NOBETCI_MAIL_TO=you@gmail.com
